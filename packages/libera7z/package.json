{
  "name": "libera7z",
  "version": "0.1.0",
  "description": "A dependency-free TypeScript reader and writer for the 7z archive format.",
  "keywords": [
    "7z",
    "7zip",
    "seven-zip",
    "archive",
    "compression",
    "lzma",
    "lzma2",
    "ppmd",
    "bzip2",
    "browser"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noojung/libera.git",
    "directory": "packages/libera7z"
  },
  "homepage": "https://github.com/noojung/libera/tree/main/packages/libera7z#readme",
  "bugs": {
    "url": "https://github.com/noojung/libera/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/index.node.js",
    "./dist/node.js",
    "./dist/worker.js",
    "./src/index.node.ts",
    "./src/node.ts",
    "./src/worker/entry.ts"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.node.js"
      },
      "browser": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./worker": {
      "types": "./dist/worker/entry.d.ts",
      "default": "./dist/worker.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "vite build && vite build -c vite.worker.config.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "check:browser": "npm run build && vite --port 5174 --open /browser-check/"
  }
}
